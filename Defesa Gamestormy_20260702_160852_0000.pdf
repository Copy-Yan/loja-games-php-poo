/T (CREATE TABLE Usuarios \( id_usuario int PRIMARY KEY AUTO_INCREMENT, nome_usuario varchar \(100\) NOT NULL, nickname varchar \(100\) UNIQUE NOT NULL, email varchar \(100\) UNIQUE NOT NULL, senha varchar \(250\) NOT NULL, data_nascimento DATE NOT NULL, status ENUM \('ativo', 'inativo', 'banido'\) NOT NULL DEFAULT 'ativo', created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP CHECK \(CHAR_LENGTH\(nome_usuario\) > 5\), CHECK \(CHAR_LENGTH\(nickname\) > 5\) \) ENGINE=InnoDB;)
/E (CREATE TABLE Usuarios \( id_usuario int PRIMARY KEY AUTO_INCREMENT, nome_usuario varchar \(100\) NOT NULL, nickname varchar \(100\) UNIQUE NOT NULL, email varchar \(100\) UNIQUE NOT NULL, senha varchar \(250\) NOT NULL, data_nascimento DATE NOT NULL, status ENUM \('ativo', 'inativo', 'banido'\) NOT NULL DEFAULT 'ativo', created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP CHECK \(CHAR_LENGTH\(nome_usuario\) > 5\), CHECK \(CHAR_LENGTH\(nickname\) > 5\) \) ENGINE=InnoDB;)
/Pg 21 0 R
/K [3]
>>
